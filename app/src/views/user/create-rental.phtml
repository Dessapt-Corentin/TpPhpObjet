<div>
    <ul>
        <li><a href="/">🔙 Retour</a></li>
    </ul>
</div>
<h1>Ajouter une location</h1>
<form action="/users/submit-rental" method="post">
    <h2>Formulaire de location</h2>

    <div>
        <label for="user_id">ID de l'utilisateur :</label>
        <input type="number" id="user_id" name="user_id" required>
    </div>

    <div>
        <label for="accommodation_id">ID du logement :</label>
        <input type="number" id="accommodation_id" name="accommodation_id" required>
    </div>

    <div>
        <label for="date_start">Date de début :</label>
        <input type="datetime-local" id="date_start" name="date_start" required>
    </div>

    <div>
        <label for="date_end">Date de fin :</label>
        <input type="datetime-local" id="date_end" name="date_end" required>
    </div>

    <button type="submit">Soumettre la location</button>
</form>